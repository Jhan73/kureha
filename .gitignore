# Python (backend/)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# environment
.env
.env.local
.env.*.local
docker-compose.override.yml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Terraform (infra/terraform/) -- state and plan output can contain
# plaintext secrets (see infra/terraform/modules/rds/main.tf's own
# comment); tfvars files hold environment-specific values, not committed.
# `.terraform.lock.hcl` is DELIBERATELY NOT ignored -- HashiCorp's own
# convention is to commit it for reproducible provider versions.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

