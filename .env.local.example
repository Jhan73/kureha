# Template for local development. Copy to `.env.local` (gitignored) and fill
# in real values where noted. See design.md §22.4 for the local-vs-production
# rationale: the only difference between environments is this file.
#
# FIXED during tasks.md 16.5's end-to-end local verification: this file
# (and design.md §22.4's own literal snippet, not edited here -- see that
# task's closure note) previously used `localhost` for both
# AWS_ENDPOINT_URL and DATABASE_URL. That value is only correct if the
# backend runs NATIVELY on the host (`uv run uvicorn`, hitting the
# `postgres`/`localstack` containers' PUBLISHED ports on 127.0.0.1) --
# docker-compose.yml's own `api` service builds and runs the SAME backend
# INSIDE a third container, where `localhost` resolves to the api
# container itself, not its sibling containers. Confirmed by actually
# running `docker compose up`: the api container failed to boot
# (`OSError: Multiple exceptions: [Errno 111] Connect call failed`)
# until these values were changed to the docker-compose SERVICE names
# (`postgres`/`localstack`), which Docker's internal DNS resolves within
# the compose network. If you run the backend natively instead of via
# `docker compose up`'s `api` service, override these two back to
# `localhost` in your own `.env.local`.

ENVIRONMENT=local

# LocalStack -- fake credentials required by boto3, do not use real ones here
AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Postgres (docker-compose `postgres` service). `app.db.py` constructs BOTH
# engines unconditionally at import time -- RUNTIME_DATABASE_URL was
# missing from this template entirely (silently fell back to
# `Settings.runtime_database_url`'s own `localhost` default, same bug).
DATABASE_URL=postgresql+asyncpg://app_user:dev_only_password@postgres:5432/kureha_dev
RUNTIME_DATABASE_URL=postgresql+asyncpg://app_runtime:dev_only_password@postgres:5432/kureha_dev

# LLM -- fill in your own key (or a mock) for local runs
OPENAI_API_KEY=sk-replace-me

# IdP -- Supabase dev project (separate from production)
SUPABASE_URL=https://<dev-project>.supabase.co
SUPABASE_ANON_KEY=dev_only_supabase_anon_key_change_me
# Admin-privileged key for staff invite; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=dev_only_supabase_service_role_key_change_me

# Canonical frontend origin used to build the `redirect_to` links sent with
# Supabase's invite/password-reset emails. Matches CORS_ALLOWED_ORIGINS'
# own `next dev` dev default; production MUST override with the real
# deployed frontend origin. See docs/supabase-setup.md §6.
FRONTEND_BASE_URL=http://localhost:3000
