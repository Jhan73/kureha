# Template for native local development (`uv run pytest`, `uv run uvicorn`, etc.
# run directly on the host, NOT via `docker compose up`'s `api` service).
# Copy to `.env.local` (gitignored) and fill in real values where noted.
#
# Running the backend inside Docker Compose instead? Use the repo-root
# `.env.local.example` template (service DNS names, not `localhost`).

ENVIRONMENT=local

# Postgres -- host-published port from docker-compose.yml's `postgres`
# service (5436, not Postgres's default 5432). Start it with:
#   docker compose up -d postgres localstack
DATABASE_URL=postgresql+asyncpg://app_user:dev_only_password@localhost:5436/kureha_dev
RUNTIME_DATABASE_URL=postgresql+asyncpg://app_runtime:dev_only_password@localhost:5436/kureha_dev

# LocalStack (host-published port from docker-compose.yml's `localstack` service).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1

# Supabase Auth (GoTrue). Required truthy by SupabaseAuthAdapter.invite_user;
# tests always override the HTTP client with a mock transport, so a
# test-only placeholder is safe here and never sent anywhere real.
# Fill in a real dev-project secret key only if you need to hit Supabase for real.
SUPABASE_SECRET_KEY=test_only_supabase_secret_key

# Operator credential plane (X-Kureha-Ops-Key) for POST /ops/tenants/bootstrap
# and friends. Empty/false -> the /ops router doesn't register at all and
# every test in tests/platform/inbound/api/routers/test_ops_tenants.py fails
# with 404. Comma-separated `key_id:sha256_hex` pairs; the two placeholder
# key_ids and their digests below match the constants
# tests/platform/inbound/api/routers/test_ops_tenants.py constructs
# (`test-ops-operator` / `test-ops-ratelimit-operator`) -- keep them in sync
# if that file's secrets ever change.
OPS_BOOTSTRAP_ENABLED=true
OPS_BOOTSTRAP_CREDENTIALS=test-ops-operator:633e7cd442497f3739f95c00bab3ccd73f5c0fffc9839f89d94d544ea1ea63f3,test-ops-ratelimit-operator:b29eb9d60dca5a33136ec80273e61f228fd16de2358679175ed7f1f2090a6cf3
