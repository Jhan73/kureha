# Copy this file to `.env.local` (gitignored) for local dev.
#
# Base URL of the backend API (see backend/app/main.py). This is a static
# export SPA (no server, no Next.js Middleware, no API routes), so this is
# inlined into the client bundle at BUILD time -- rebuild after changing it.
# Defaults to http://localhost:8000 (backend/app/config.py's local dev port)
# when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
